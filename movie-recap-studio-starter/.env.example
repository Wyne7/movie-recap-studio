# Supabase browser-safe values (publishable key is protected by database RLS policies)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider secrets. Never add NEXT_PUBLIC_ to these values.
GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Cloudflare R2 server-only credentials (for a later storage milestone)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
